    given-names: Gabriel Mariano

  - family-names: Freitas
    given-names: Carlos Augusto Porto

repository-code: https://github.com/pymodulation/pymodulation
url: https://pymodulation.github.io/pymodulation/

doi: 10.5281/zenodo.18202697

license: LGPL-3.0-only

keywords:
  - Digital Modulation
  - Digital Demodulation
  - Software-Defined Radio
  - SDR
  - Digital Communications
  - Signal Processing
  - Python
  - GFSK
  - GMSK
  - BPSK
  - QPSK
  - LoRa
